+	/** Stamp one reason onto one object WITHOUT making it the object's own: component inheritance. */
+	public static void inherit(SootMethod m, ObjectNode obj, EscapeReason r) {
+		if (m == null || obj == null || r == null) return;
+		Map<ObjectNode, EnumSet<EscapeReason>> mm = forMethod(m);
+		synchronized (mm) {
+			mm.computeIfAbsent(obj, k -> EnumSet.noneOf(EscapeReason.class)).add(r);
+		}
