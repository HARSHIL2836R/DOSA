 	/**
@@ -157,4 +195,37 @@
 		int g = getViaGroup(m, obj);
 		return g < 0 ? new HashSet<>() : new HashSet<>(viaGroups.get(g));
 	}
+
+	/*
+	 * Own pointers (patch 0005): the successors a propagated reason fired through ON THIS
+	 * member, as opposed to the component's union above. Unlike the union group they keep
+	 * pointers to siblings in the same component, because a sibling that already escaped is a
+	 * real cause for this member. They live in the same viaGroups list, so one .via file and one
+	 * numbering serve both; identical sets are interned to one index. Own groups are never
+	 * merged, so interning a copy as the key is safe.
+	 */
+	public static final Map<SootMethod, Map<ObjectNode, Integer>> ownViaGroupOf = new ConcurrentHashMap<>();
+	private static final Map<Set<Via>, Integer> ownIntern = new java.util.HashMap<>();
+
+	public static synchronized void assignOwnVia(SootMethod m, ObjectNode obj, Set<Via> vs) {
+		if (m == null || obj == null || vs == null || vs.isEmpty()) return;
+		Map<ObjectNode, Integer> mm = ownViaGroupOf.computeIfAbsent(m, k -> new ConcurrentHashMap<>());
+		Integer old = mm.get(obj);
+		Set<Via> key = new HashSet<>(vs);
+		if (old != null) key.addAll(viaGroups.get(old));
+		key = java.util.Collections.unmodifiableSet(key);
+		Integer g = ownIntern.get(key);
+		if (g == null) {
+			g = newViaGroup(key);
+			ownIntern.put(key, g);
+		}
+		mm.put(obj, g);
+	}
+
+	/** -1 when the object has no own pointers. */
+	public static synchronized int getOwnViaGroup(SootMethod m, ObjectNode obj) {
+		Map<ObjectNode, Integer> mm = ownViaGroupOf.get(m);
+		Integer g = (mm == null) ? null : mm.get(obj);
+		return g == null ? -1 : g;
+	}
 }
