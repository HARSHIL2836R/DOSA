+
+	public static EnumSet<EscapeReason> getOwn(SootMethod m, ObjectNode obj) {
+		Map<ObjectNode, EnumSet<EscapeReason>> om = own.get(m);
+		if (om == null) return EnumSet.noneOf(EscapeReason.class);
+		synchronized (om) {
