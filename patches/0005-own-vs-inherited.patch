+	static String reasonList(EnumSet<EscapeReason> rs) {
+		StringBuilder sb = new StringBuilder();
+		for (EscapeReason r : rs) {          // EnumSet iterates in declaration order
+			if (sb.length() > 0) sb.append(",");
+			sb.append(r.name());
+		}
+		return sb.toString();
+	}
+
+	/** Renumber a raw via-group index by first appearance, writing the group on first sight. */
+	static String viaGroupNumber(String raw, Map<String, Integer> renumber,
+								 java.io.BufferedWriter viaOut) throws IOException {
+		if (raw == null) return "";
+		Integer n = renumber.get(raw);
+		if (n == null) {
+			n = renumber.size();
+			renumber.put(raw, n);
+			List<String> ptrs = new ArrayList<>();
+			for (EscapeReasons.Via v : EscapeReasons.viaGroups.get(Integer.parseInt(raw)))
+				ptrs.add(v.toString());
+			Collections.sort(ptrs);
+			viaOut.write(n + "\t");
+			for (int i = 0; i < ptrs.size(); i++) {
+				if (i > 0) viaOut.write(";");
+				viaOut.write(ptrs.get(i));
+			}
+			viaOut.write("\n");
+		}
+		return Integer.toString(n);
+	}
