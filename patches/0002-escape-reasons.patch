diff -ruN a/src/es/EscapeReason.java b/src/es/EscapeReason.java
--- a/src/es/EscapeReason.java	1970-01-01 05:30:00.000000000 +0530
+++ b/src/es/EscapeReason.java	2026-09-02 00:11:37.305916000 +0530
@@ -0,0 +1,80 @@
+package es;
+
+/*
+ * EscapeReason — why an abstract object was marked Escape.
+ *
+ * This enum exists because the lattice cannot carry the information. `Escape` is a singleton
+ * with hashCode() == 0 (es/Escape.java) and EscapeStatus.purge()/purgeAndEscape() replaces the
+ * whole status set with {Escape} the moment escape is established. So by construction every
+ * escaping object has exactly one status and no alternatives survive. The reasons live in a
+ * side map (es/EscapeReasons.java) that is append-only, and nothing here is ever read by the
+ * analysis: the verdict is computed exactly as it was before.
+ *
+ * One constant per site that can introduce Escape. The census was taken with
+ *     grep -rn "cascadeEscape\|setEscape()\|new EscapeStatus(Escape.getInstance())" src/
+ * over stava at e03dac0 and every line below was read before it was stamped.
+ *
+ * isSurrender() splits "the program does this" from "the analysis gave up". That split is a
+ * first-class output: it is what separates a property of the benchmark from a property of
+ * Stava.
+ */
+public enum EscapeReason {
+
+	// ---- real escapes ---------------------------------------------------------------
+	/** StoreStmt.java:117, StaticStoreStmt — `C.f = local`. */
+	STATIC_FIELD_STORE(false),
+	/** StoreStmt.java:103 — `a.f = b` where a's base has no points-to set. */
+	STORE_UNTRACKED_BASE(false),
+	/** StoreStmt.java:128, :145 — a class or string constant stored into a field/array. */
+	CONSTANT_STORE(false),
+	/** StoreStmt.java:40 — the MarkStoreEscaping short circuit, before the LHS is examined. */
+	STORE_CASCADE_UNTYPED(false),
+	/** LoadStmt.java:45 — `local = C.staticField`; the loaded value is globally reachable. */
+	STATIC_FIELD_LOAD(false),
+	/** LoadStmt.java:101, :123 — `a = b.f` / `a = b[i]` where b has no points-to set. */
+	LOAD_UNTRACKED_BASE(false),
+	/** JAssignStmtHandler.java:72 — an interned String/Class constant materialised in a local. */
+	CONSTANT_OBJECT(false),
+	/** NewStmt.java:49 — IsMultiThreadedClass.check, the allocated class is thread-reachable. */
+	THREAD_REACHABLE_CLASS(false),
+	/** JThrowStmtHandler.java:19. */
+	THROWN(false),
+	/** MonitorStmtHandler.java:20 — used as a monitor. */
+	MONITOR(false),
+	/** JInvokeStmtHandler.java:200 — argument to a blacklisted native. */
+	NATIVE_BLACKLIST(false),
+	/** JIdentityStmtHandler.java:49 — a caught-exception reference. */
+	CAUGHT_EXCEPTION(false),
+	/** ReworkedResolver.java:645 isReturnObject, fires at :652. */
+	RETURNED(false),
+	/** ReworkedResolver.java:582 isAssignedToThis, reached through isEscapingObject at :655. */
+	ASSIGNED_TO_THIS_OR_PARAM(false),
+	/** ReworkedResolver.java:666 isEscapingParam, fires at :668. */
+	PARAM_ESCAPES_VIA_SUCCESSOR(false),
+	/** ReworkedResolver.java:688 isEscapingObject(nxt), fires at :690. */
+	TRANSITIVE_SUCCESSOR(false),
+
+	// ---- analysis surrender, not escape ---------------------------------------------
+	/**
+	 * The object has no recoverable bytecode index and is folded onto the singleton
+	 * InvalidBCIObjectNode: NewStmt.java:56, LoadStmt.java:93, StoreStmt.java:161, :178,
+	 * JAssignStmtHandler.java:73.
+	 */
+	NO_BCI_OBJECT(true),
+	/** StaticAnalyser.java:323, setParamsAsEscaping — the whole method had no BCI. */
+	NO_BCI_METHOD(true),
+	/** ReworkedResolver.java:557 — the method is in noBCIMethods, seen from the resolver. */
+	NO_BCI_METHOD_AT_RESOLVER(true),
+	/** KillCallerOnly.java:33 — status is caller-conditional only and nothing will resolve it. */
+	CALLER_ONLY_UNRESOLVABLE(true);
+
+	private final boolean surrender;
+
+	EscapeReason(boolean surrender) {
+		this.surrender = surrender;
+	}
+
+	public boolean isSurrender() {
+		return surrender;
+	}
+}
diff -ruN a/src/es/EscapeReasons.java b/src/es/EscapeReasons.java
--- a/src/es/EscapeReasons.java	1970-01-01 05:30:00.000000000 +0530
+++ b/src/es/EscapeReasons.java	2026-09-02 00:11:37.301740700 +0530
@@ -0,0 +1,74 @@
+package es;
+
+import ptg.ObjectNode;
+import soot.SootMethod;
+
+import java.util.EnumSet;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+/*
+ * EscapeReasons — the append-only side map.
+ *
+ * Keyed the same way the rest of the analysis keys an abstract object: (declaring method,
+ * ObjectNode). Nothing in this class is ever read by the analysis; it is write-only from the
+ * analysis's point of view and is drained once, by Main.printReasons, after resolution.
+ *
+ * APPEND-ONLY IS THE WHOLE POINT. EscapeStatus.purge() exists precisely to discard
+ * alternatives once Escape is present, which is why the multiplicity this map records cannot
+ * be recovered from the lattice afterwards. Nothing here ever removes a reason.
+ *
+ * Thread safety: Soot may run BodyTransformers concurrently (StaticAnalyser already uses
+ * ConcurrentHashMap for ptgs and summaries), so the outer maps are concurrent and each
+ * per-method map is guarded while an EnumSet is mutated. EnumSet itself is not thread safe.
+ */
+public class EscapeReasons {
+
+	public static final Map<SootMethod, Map<ObjectNode, EnumSet<EscapeReason>>> reasons =
+			new ConcurrentHashMap<>();
+
+	private static Map<ObjectNode, EnumSet<EscapeReason>> forMethod(SootMethod m) {
+		return reasons.computeIfAbsent(m, k -> new ConcurrentHashMap<>());
+	}
+
+	/** Stamp one reason onto one object. Silently ignores a null method: see note in seen(). */
+	public static void record(SootMethod m, ObjectNode obj, EscapeReason r) {
+		if (m == null || obj == null || r == null) return;
+		Map<ObjectNode, EnumSet<EscapeReason>> mm = forMethod(m);
+		synchronized (mm) {
+			mm.computeIfAbsent(obj, k -> EnumSet.noneOf(EscapeReason.class)).add(r);
+		}
+	}
+
+	/**
+	 * Register an object with no reason, so that the zero bucket in the histogram is real
+	 * rather than inferred from absence. Objects that never escape must appear in .reasons
+	 * with an empty reason list.
+	 *
+	 * A null method means the PointsToGraph in hand was not the one StaticAnalyser.apply set
+	 * a method on — that would be a bug rather than a missing reason, so it is counted.
+	 */
+	public static void seen(SootMethod m, ObjectNode obj) {
+		if (m == null || obj == null) {
+			nullMethodDrops.incrementAndGet();
+			return;
+		}
+		Map<ObjectNode, EnumSet<EscapeReason>> mm = forMethod(m);
+		synchronized (mm) {
+			mm.computeIfAbsent(obj, k -> EnumSet.noneOf(EscapeReason.class));
+		}
+	}
+
+	/** Counted and printed by Main so a silent attribution loss cannot go unnoticed. */
+	public static final java.util.concurrent.atomic.AtomicLong nullMethodDrops =
+			new java.util.concurrent.atomic.AtomicLong();
+
+	public static EnumSet<EscapeReason> get(SootMethod m, ObjectNode obj) {
+		Map<ObjectNode, EnumSet<EscapeReason>> mm = reasons.get(m);
+		if (mm == null) return EnumSet.noneOf(EscapeReason.class);
+		synchronized (mm) {
+			EnumSet<EscapeReason> s = mm.get(obj);
+			return s == null ? EnumSet.noneOf(EscapeReason.class) : EnumSet.copyOf(s);
+		}
+	}
+}
