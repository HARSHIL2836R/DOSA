+
+	/*
+	 * via — the successor a PROPAGATED reason fired through.
+	 *
+	 * TRANSITIVE_SUCCESSOR and PARAM_ESCAPES_VIA_SUCCESSOR are not causes. Each says "a
+	 * successor already escapes", and the cause is whatever made that successor escape. The
+	 * enum alone cannot name it, so every firing also records the successor here, as the
+	 * (method, ObjectNode) pair the analysis keys it by. The extractor follows these pointers
+	 * and replaces the propagated reason with the causes at the end of the chain.
+	 *
+	 * Recorded at the moment the reason fires, not rebuilt from .info afterwards, because the
+	 * .info dependency edge is not reliable: on avrora 41.6 % of internal objects carrying
+	 * TRANSITIVE_SUCCESSOR have no out-edge at all (tools/orphan_transitive.py).
+	 *
+	 * ONE SET PER COMPONENT, NOT PER OBJECT. The pointers are stamped component-wide like the
+	 * reasons, and copying the union onto every member is |component| x |pointers|: the first
+	 * avrora run of this patch died of OutOfMemoryError writing exactly that. So a component's
+	 * pointers are stored once as a group, each member holds only the group's index, and
+	 * printReasons writes the groups once, to <dirname>.via.
+	 *
+	 * A group can be EMPTY: the propagated reason fired, but only through a successor in the
+	 * same component, whose causes the component already carries. That is different from "no
+	 * group", which means no pointer was recorded at all.
+	 *
+	 * Same discipline as the reason map: append-only, never read by the analysis.
+	 */
+	public static final Map<SootMethod, Map<ObjectNode, Integer>> viaGroupOf = new ConcurrentHashMap<>();
+	public static final java.util.List<Set<Via>> viaGroups = new java.util.ArrayList<>();
+
+	public static final class Via {
+		public final SootMethod method;
+		public final ObjectNode obj;
+
+		public Via(SootMethod method, ObjectNode obj) {
+			this.method = method;
+			this.obj = obj;
+		}
+
+		@Override
+		public boolean equals(Object o) {
+			if (!(o instanceof Via)) return false;
+			Via v = (Via) o;
+			return method == v.method && obj.equals(v.obj);
+		}
+
+		@Override
+		public int hashCode() {
+			return Objects.hash(System.identityHashCode(method), obj);
+		}
+
+		/** method|ref|type — `|` and `;` cannot occur in a Soot method signature. */
+		@Override
+		public String toString() {
+			return method + "|" + obj.ref + "|" + obj.type;
+		}
+	}
+
+	/** Store one component's pointer set; returns the index members are assigned. */
+	public static synchronized int newViaGroup(Set<Via> vs) {
+		viaGroups.add(new HashSet<>(vs));
+		return viaGroups.size() - 1;
+	}
+
+	/** Point one object at a group. An object already in a group has the new set merged in. */
+	public static synchronized void assignViaGroup(SootMethod m, ObjectNode obj, int g) {
+		if (m == null || obj == null) return;
+		Map<ObjectNode, Integer> mm = viaGroupOf.computeIfAbsent(m, k -> new ConcurrentHashMap<>());
+		Integer old = mm.get(obj);
+		if (old == null) mm.put(obj, g);
+		else if (old != g) viaGroups.get(old).addAll(viaGroups.get(g));
+	}
+
+	/** -1 when the object has no group. */
+	public static synchronized int getViaGroup(SootMethod m, ObjectNode obj) {
+		Map<ObjectNode, Integer> mm = viaGroupOf.get(m);
+		Integer g = (mm == null) ? null : mm.get(obj);
+		return g == null ? -1 : g;
+	}
+
+	public static synchronized Set<Via> getVia(SootMethod m, ObjectNode obj) {
+		int g = getViaGroup(m, obj);
+		return g < 0 ? new HashSet<>() : new HashSet<>(viaGroups.get(g));
+	}
 }
